# ---- Database (Postgres) ----------------------------------------------------
# Tables are created automatically on first start. Use a dedicated database, e.g. "bookstore".
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/bookstore
# Set to true only if your database requires SSL (most managed databases do; Coolify's internal one does not).
DATABASE_SSL=false
# The bookstore keeps all its tables in this schema, so it can share a database with other apps.
DATABASE_SCHEMA=bookstore

# ---- Admin -----------------------------------------------------------------
# Password for /admin (post books, see sales). Use a long random value.
ADMIN_PASSWORD=

# ---- Public URL (used for the Nomba return URL and links in emails) --------
SITE_URL=http://localhost:3000

# ---- Nomba — same credentials the trios / buzzycash backends use ------------
NOMBA_CLIENT_ID=
NOMBA_PRIVATE_KEY=
NOMBA_ACCOUNT_ID=
NOMBA_WEBHOOK_SIGNATURE_KEY=
NOMBA_API_BASE=https://api.nomba.com/v1

# ---- Lenhub email — same values trios-staging uses ---------------------------
LENHUB_API_BASE=
LENHUB_CLIENT_ID=
LENHUB_API_KEY=
LENHUB_SENDER_ID=

# ---- Optional ---------------------------------------------------------------
# Signs download links and the admin session (falls back to a key derived from other secrets).
EBOOK_LINK_SECRET=
# Downloads allowed per purchase link (default 3). Links last 7 days.
EBOOK_MAX_DOWNLOADS=3
# Largest book PDF the admin may upload, in MB (default 100).
MAX_PDF_MB=100
# Development inserts one dummy book on an empty database. true/false overrides that (never seeded in production by default).
SEED_DEMO_BOOK=
